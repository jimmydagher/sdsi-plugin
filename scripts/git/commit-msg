#!/bin/sh
# SDSI release chain (sdsi:versioning) — non-negotiable for every project
# this is copied into.
#
# Overwrites the commit message outright with a single line naming the
# version — never appended to, never combined with a description. What
# changed lives in CHANGELOG.md's entry for that version; `git log` is a
# clean version timeline.
#
#   VERSION x.y.z      this commit released x.y.z (pre-commit bumped VERSION)
#   VERSION x.y.z+k    the k-th docs-only commit since x.y.z — SemVer build
#                      metadata, so every tool still reads it as x.y.z
#
# k counts back along main's first parents to the last line naming x.y.z.
# Don't amend on main: an amend is labelled as a new docs-only commit, so
# make a new commit instead.
#
# Installed via:  git config core.hooksPath scripts/git
#                 git config commit.template scripts/git/commit-template

repo_root=$(git rev-parse --show-toplevel)
msg_file="$1"

# Keep in sync with VERSION_FILE in scripts/python/release.py.
VERSION_FILE="meta/VERSION"

# Keep in sync with scripts/git/pre-commit.
TARGET_BRANCH="main"
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$branch" != "$TARGET_BRANCH" ]; then
    exit 0
fi

if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
    exit 0
fi

current_version=$(tr -d '[:space:]' < "$repo_root/$VERSION_FILE")
release="VERSION $current_version"

if git diff --cached --name-only -- "$VERSION_FILE" | grep -qx "$VERSION_FILE"; then
    line="$release"
else
    # The last line naming this version decides k: the release itself → 1,
    # "+k" → k + 1. Anything else (a merge, an older "-updated") is skipped.
    k=$(git log --first-parent --format=%s 2>/dev/null | awk -v release="$release" '
        $0 == release { print 1; exit }
        index($0, release "+") == 1 {
            k = substr($0, length(release) + 2)
            if (k ~ /^[0-9]+$/) { print k + 1; exit }
        }')
    line="$release+${k:-1}"
fi

printf '%s\n' "$line" > "$msg_file"

exit 0
